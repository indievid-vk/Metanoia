# Handle binary files correctly - prevent Git from corrupting them
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.svg binary
*.gif binary
*.pdf binary

# Fonts protection
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

# Books and Documents
*.epub binary
*.fb2 binary
*.mobi binary

# Archives
*.zip binary
*.gz binary
